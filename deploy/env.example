# ~/.config/claude-sync/env  (chmod 600)

# Адрес хоста VPS внутри туннеля Amnezia: доступен только под VPN.
BIND_ADDR=ip:port

AUTH_USER=change-me
AUTH_PASS=change-me-long-random

# Имя ноды: попадает в заголовок страницы и в сообщения wip-коммитов.
NODE_NAME=vps1

# Остальное можно не трогать, это значения по умолчанию.
# CLAUDE_BIN=/home/aragami3070/.local/bin/claude
# CLAUDE_HOME=/home/aragami3070/.claude
# CLAUDE_JSON=/home/aragami3070/.claude.json
# TMUX_SOCKET=claude-sync
# GIT_REMOTE=origin
# WIP_PREFIX=vps-wip/
# START_TIMEOUT_SECS=20
# STOP_TIMEOUT_SECS=20
# STATE_DIR=/home/aragami3070/.local/state/claude-sync
# LIST_LIMIT=50
# RUST_LOG=info
